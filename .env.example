# Copy this file to ".env" and edit the values you need.
# Create React App reads it every time you run `npm start` / `npm run build`
# and only exposes variables whose name starts with REACT_APP_.

# Where the Flask face API runs (backend/config.py FACE_API_HOST / FACE_API_PORT).
REACT_APP_API_BASE_URL=http://localhost:3001

# The port this dev server binds to (default 3000).
# PORT=3000

# Open the browser on a different host, or not at all.
# HOST=127.0.0.1
# BROWSER=none
