# Copy this file to ".env" and edit the values you need.
# Create React App reads it every time you run `npm start` / `npm run build`
# and only exposes variables whose name starts with REACT_APP_.

# Where the Flask face API runs (backend/config.py FACE_API_HOST / FACE_API_PORT).
#
# Leave this COMMENTED OUT for the default: the app asks for "/api/..." on its
# own origin, which is what `npm start` (dev-server proxy) and the Vercel deploy
# (vercel.json rewrite to the backend service) both expect. Setting it bakes
# the value into the bundle, so a build published on Vercel must not point at
# localhost.
#
# Uncomment only when the API is on another machine:
# REACT_APP_API_BASE_URL=http://192.168.1.20:3001

# The port this dev server binds to (default 3000).
# PORT=3000

# Open the browser on a different host, or not at all.
# HOST=127.0.0.1
# BROWSER=none
